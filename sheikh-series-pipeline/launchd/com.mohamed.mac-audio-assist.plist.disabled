<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mohamed.mac-audio-assist</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-u</string>
        <string>/Users/macm1pro/REPOS/SKILLS/sheikh-series-pipeline/scripts/mac_audio_assist.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/macm1pro/workspace/ytb-build</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/macm1pro</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>ASSIST_WORKERS</key>
        <string>2</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/macm1pro/workspace/ytb-build/mac_audio_assist.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macm1pro/workspace/ytb-build/mac_audio_assist.log</string>
</dict>
</plist>
